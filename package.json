{
  "name": "food-ordering-platform-root",
  "private": true,
  "version": "1.0.0",
  "description": "Production-grade Pizza Hut inspired food ordering platform workspace",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "node -e \"try{require('husky').default()}catch(e){}\""
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx,js,jsx,json,css}": [
      "prettier --write",
      "npm --prefix frontend run lint -- --fix"
    ],
    "backend/src/**/*.ts": [
      "prettier --write",
      "npm --prefix backend run lint -- --fix"
    ]
  }
}